# Dependencies and build output
node_modules/
dist/
coverage/
.vite/

# Environment and secrets
.env
.env.*
!.env.example

# Data: only documentation and placeholders are versioned
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Literature: only openly licensed PDFs are versioned (literature/open/);
# other downloaded papers stay local (see literature/README.md)
literature/restricted/**
!literature/restricted/README.md

# Local clones of third-party implementations (reference only, not versioned)
external/**
!external/README.md
